# Use process environment. The existing creative-tools .env is never loaded.
MONEY_MODE=simulation
AUTH_PROVIDER=eliza-cloud
ELIZA_CLOUD_API_URL=https://api.eliza.app
PORT=8740
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8740
# Use your own Steward deployment for passwordless identity and wallet setup.
# Financial conversions remain simulated until an actual investment provider is integrated.
# AUTH_PROVIDER=steward
# STEWARD_API_URL=https://YOUR_OWNED_STEWARD_API_ORIGIN
# Or use Eliza Cloud's existing first-party login gateway:
# AUTH_PROVIDER=eliza-cloud
# ELIZA_CLOUD_API_URL=https://api.eliza.app
# STEWARD_SESSION_ENCRYPTION_KEY=BASE64_ENCODED_32_RANDOM_BYTES
# Development only: a protected persistent key file is generated if omitted.
# STEWARD_SESSION_KEY_FILE=data/steward-session.key
# For the fully offline password-based test wallet only: AUTH_PROVIDER=demo
# Optional server Postgres; default local embedded PostgreSQL store is data/blunts.
# DATABASE_URL=postgresql://blunts:URL_ENCODED_PASSWORD@localhost:5432/blunts
